{
  "rationale": "Combining customer and product features to predict purchases in the next 7 days, incorporating time decay for recent purchases.",
  "aggregates": [
    {
      "name": "f_customer_product_frequency",
      "keys": [
        "customer_id",
        "product_code"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_customer_department_frequency",
      "keys": [
        "customer_id",
        "department_no"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_product_sales_count",
      "keys": [
        "product_code"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_product_days_since_last_purchase",
      "keys": [
        "product_code"
      ],
      "sql": "min(days_ago)"
    }
  ],
  "derived": [
    {
      "name": "f_customer_past_purchases",
      "sql": "CASE WHEN f_customer_product_frequency > 0 THEN 1 ELSE 0 END"
    },
    {
      "name": "f_product_popularity_score",
      "sql": "(f_product_sales_count - f_product_days_since_last_purchase) / f_product_sales_count"
    },
    {
      "name": "f_combined_frequency",
      "sql": "f_customer_product_frequency + f_customer_department_frequency * 0.1 + f_product_popularity_score * 0.5"
    },
    {
      "name": "f_time_decay",
      "sql": "exp(-(days_ago/30))"
    }
  ]
}
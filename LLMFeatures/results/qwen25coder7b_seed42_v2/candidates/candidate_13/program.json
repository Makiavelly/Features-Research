{
  "rationale": "We need to capture the customer's recent purchasing behavior and the diversity of products they have purchased to predict their future purchases within the next 7 days.",
  "aggregates": [
    {
      "name": "f_customer_purchase_count",
      "keys": [
        "customer_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_article_diversity",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(article_id)"
    },
    {
      "name": "f_last_purchase_age",
      "keys": [
        "customer_id"
      ],
      "sql": "min(days_ago)"
    },
    {
      "name": "f_avg_article_price",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(price)"
    },
    {
      "name": "f_total_spent",
      "keys": [
        "customer_id"
      ],
      "sql": "sum(price)"
    }
  ],
  "derived": [
    {
      "name": "f_recent_purchase_ratio",
      "sql": "coalesce(f_customer_purchase_count / greatest(f_last_purchase_age, 1), -1.0)"
    },
    {
      "name": "f_purchase_diversity_per_article",
      "sql": "coalesce(f_article_diversity / f_customer_purchase_count, -1.0)"
    },
    {
      "name": "f_avg_price_per_purchase",
      "sql": "coalesce(f_total_spent / f_customer_purchase_count, -1.0)"
    }
  ]
}
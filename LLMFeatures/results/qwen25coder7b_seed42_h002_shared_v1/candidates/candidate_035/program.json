{
  "rationale": "Calculate features based on customer interaction patterns and product attributes to improve recommendation performance.",
  "aggregates": [
    {
      "name": "f_unique_articles_purchased",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_code)"
    },
    {
      "name": "f_total_transactions",
      "keys": [
        "customer_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_avg_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_max_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_unique_sales_channels",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(sales_channel_id)"
    },
    {
      "name": "f_avg_price",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(price)"
    },
    {
      "name": "f_min_price",
      "keys": [
        "customer_id"
      ],
      "sql": "min(price)"
    },
    {
      "name": "f_max_price",
      "keys": [
        "customer_id"
      ],
      "sql": "max(price)"
    },
    {
      "name": "f_unique_product_types",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_type_no)"
    }
  ],
  "derived": [
    {
      "name": "f_transaction_frequency",
      "sql": "f_total_transactions / f_unique_articles_purchased"
    },
    {
      "name": "f_days_since_last_purchase",
      "sql": "f_max_days_ago - f_avg_days_ago"
    },
    {
      "name": "f_sales_channel_diversity",
      "sql": "f_unique_sales_channels / 2.0"
    },
    {
      "name": "f_price_variance",
      "sql": "(f_max_price - f_min_price) / (f_avg_price + 1)"
    },
    {
      "name": "f_product_type_diversity",
      "sql": "1.0 / (1 + exp(-f_unique_product_types))"
    }
  ]
}
{
  "rationale": "This program creates features based on customer interaction patterns and product attributes to predict purchases in the next 7 days. These features are designed to capture both the frequency of transactions and the recency of interactions with products and categories, leveraging aggregate functions for customer-level and product-level metrics.",
  "aggregates": [
    {
      "name": "f_customer_recent_transactions",
      "keys": [
        "customer_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_customer_unique_products",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_code)"
    },
    {
      "name": "f_customer_avg_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_customer_max_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_product_recent_transactions",
      "keys": [
        "product_code"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_product_total_customers",
      "keys": [
        "product_code"
      ],
      "sql": "approx_count_distinct(customer_id)"
    },
    {
      "name": "f_product_avg_days_ago",
      "keys": [
        "product_code"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_product_max_days_ago",
      "keys": [
        "product_code"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_category_recent_transactions",
      "keys": [
        "product_type_no"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_category_total_customers",
      "keys": [
        "product_type_no"
      ],
      "sql": "approx_count_distinct(customer_id)"
    },
    {
      "name": "f_category_avg_days_ago",
      "keys": [
        "product_type_no"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_category_max_days_ago",
      "keys": [
        "product_type_no"
      ],
      "sql": "max(days_ago)"
    }
  ],
  "derived": [
    {
      "name": "f_customer_transaction_rate",
      "sql": "NULLIF(f_customer_recent_transactions, 0) / f_customer_unique_products"
    },
    {
      "name": "f_customer_days_since_last_purchase",
      "sql": "NULLIF(f_customer_max_days_ago - f_customer_avg_days_ago, 0)"
    },
    {
      "name": "f_product_transaction_rate",
      "sql": "NULLIF(f_product_recent_transactions, 0) / f_product_total_customers"
    },
    {
      "name": "f_product_days_since_last_purchase",
      "sql": "NULLIF(f_product_max_days_ago - f_product_avg_days_ago, 0)"
    },
    {
      "name": "f_category_transaction_rate",
      "sql": "NULLIF(f_category_recent_transactions, 0) / f_category_total_customers"
    },
    {
      "name": "f_category_days_since_last_purchase",
      "sql": "NULLIF(f_category_max_days_ago - f_category_avg_days_ago, 0)"
    }
  ]
}
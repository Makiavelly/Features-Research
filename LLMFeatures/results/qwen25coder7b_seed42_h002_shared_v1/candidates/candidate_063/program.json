{
  "rationale": "Combining customer demographic information with product categories and transaction history to predict future purchases.",
  "aggregates": [
    {
      "name": "f_avg_price",
      "keys": [
        "customer_id",
        "product_type_no"
      ],
      "sql": "avg(price) FILTER (WHERE days_ago <= 7)"
    },
    {
      "name": "f_unique_products",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_code) FILTER (WHERE days_ago <= 7)"
    },
    {
      "name": "f_avg_sales_channel",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(sales_channel_id) FILTER (WHERE days_ago <= 7)"
    },
    {
      "name": "f_max_days_ago",
      "keys": [
        "customer_id",
        "product_code"
      ],
      "sql": "max(days_ago) FILTER (WHERE days_ago <= 7)"
    }
  ],
  "derived": [
    {
      "name": "f_is_recent_buyer",
      "sql": "case when f_max_days_ago < 30 then 1 else 0 end"
    },
    {
      "name": "f_avg_transaction_value",
      "sql": "(f_avg_price * raw_u_age) / f_unique_products"
    }
  ]
}
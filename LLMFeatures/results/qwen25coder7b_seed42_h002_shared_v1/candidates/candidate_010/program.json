{
  "rationale": "Calculate aggregate features based on past purchases and combine them with derived features to predict future purchases.",
  "aggregates": [
    {
      "name": "f_avg_price",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(price)"
    },
    {
      "name": "f_purchases_count",
      "keys": [
        "customer_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_unique_products",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_code)"
    },
    {
      "name": "f_avg_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_freq_product_type_no",
      "keys": [
        "customer_id",
        "product_type_no"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_freq_garment_group_no",
      "keys": [
        "customer_id",
        "garment_group_no"
      ],
      "sql": "count(*)"
    }
  ],
  "derived": [
    {
      "name": "f_purchase_power",
      "sql": "cast(f_avg_price as REAL) * f_purchases_count"
    },
    {
      "name": "f_recent_activity",
      "sql": "CASE WHEN f_avg_days_ago < 30 THEN 1 ELSE 0 END"
    },
    {
      "name": "f_freq_product_type_no_ratio",
      "sql": "cast(f_freq_product_type_no as REAL) / f_unique_products"
    },
    {
      "name": "f_freq_garment_group_no_ratio",
      "sql": "cast(f_freq_garment_group_no as REAL) / f_unique_products"
    }
  ]
}
{
  "rationale": "Incorporate time-based features to capture temporal patterns in customer behavior and product popularity.",
  "aggregates": [
    {
      "name": "f_customer_days_ago_avg",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_article_sales_count",
      "keys": [
        "product_code"
      ],
      "sql": "count(*)"
    }
  ],
  "derived": [
    {
      "name": "f_time_decay_price",
      "sql": "price * exp(-0.1 * days_ago)"
    }
  ]
}
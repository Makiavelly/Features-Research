{
  "rationale": "Enhanced features that incorporate customer interaction patterns, product attributes, and temporal factors to improve LightGBM validation MAP@12 on FIXED ID-GNN candidate pools.",
  "aggregates": [
    {
      "name": "f_customer_recent_transactions",
      "keys": [
        "customer_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_customer_unique_products",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(product_code)"
    },
    {
      "name": "f_customer_avg_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_customer_max_days_ago",
      "keys": [
        "customer_id"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_customer_unique_sales_channels",
      "keys": [
        "customer_id"
      ],
      "sql": "approx_count_distinct(sales_channel_id)"
    },
    {
      "name": "f_product_recent_transactions",
      "keys": [
        "product_code"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_product_total_customers",
      "keys": [
        "product_code"
      ],
      "sql": "approx_count_distinct(customer_id)"
    },
    {
      "name": "f_product_avg_days_ago",
      "keys": [
        "product_code"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_product_max_days_ago",
      "keys": [
        "product_code"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_category_recent_transactions",
      "keys": [
        "product_type_no"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_category_total_customers",
      "keys": [
        "product_type_no"
      ],
      "sql": "approx_count_distinct(customer_id)"
    },
    {
      "name": "f_category_avg_days_ago",
      "keys": [
        "product_type_no"
      ],
      "sql": "avg(days_ago)"
    },
    {
      "name": "f_category_max_days_ago",
      "keys": [
        "product_type_no"
      ],
      "sql": "max(days_ago)"
    },
    {
      "name": "f_customer_lifetime_value",
      "keys": [
        "customer_id"
      ],
      "sql": "sum(price)"
    },
    {
      "name": "f_product_popularity",
      "keys": [
        "product_code"
      ],
      "sql": "count(*) * f_product_total_customers"
    },
    {
      "name": "f_category_sales_channel_diversity",
      "keys": [
        "product_type_no"
      ],
      "sql": "approx_count_distinct(sales_channel_id)"
    }
  ],
  "derived": [
    {
      "name": "f_customer_transaction_rate",
      "sql": "f_customer_recent_transactions / f_customer_unique_products"
    },
    {
      "name": "f_customer_days_since_last_purchase",
      "sql": "f_customer_max_days_ago - f_customer_avg_days_ago"
    },
    {
      "name": "f_product_transaction_rate",
      "sql": "f_product_recent_transactions / f_product_total_customers"
    },
    {
      "name": "f_product_days_since_last_purchase",
      "sql": "f_product_max_days_ago - f_product_avg_days_ago"
    },
    {
      "name": "f_category_transaction_rate",
      "sql": "f_category_recent_transactions / f_category_total_customers"
    },
    {
      "name": "f_category_days_since_last_purchase",
      "sql": "f_category_max_days_ago - f_category_avg_days_ago"
    },
    {
      "name": "f_customer_ltv_per_product",
      "sql": "f_customer_lifetime_value / f_customer_unique_products"
    },
    {
      "name": "f_product_sales_channel_diversity",
      "sql": "f_product_popularity / f_category_sales_channel_diversity"
    }
  ]
}
        "reference_sql": "\nWITH u AS (\n SELECT customer_id,count(*) AS n,\n count(*) FILTER(WHERE days_ago<=30) AS n30,\n count(*) FILTER(WHERE days_ago<=365) AS n365,\n min(days_ago) AS recency,avg(price) AS mean_price,\n avg(CASE WHEN sales_channel_id=2 THEN 1.0 ELSE 0.0 END) AS channel2\n FROM history GROUP BY customer_id),\ni AS (\n SELECT article_id,count(*) AS n,\n count(*) FILTER(WHERE days_ago<=7) AS n7,\n count(*) FILTER(WHERE days_ago<=30) AS n30,\n count(*) FILTER(WHERE days_ago<=90) AS n90,\n count(*) FILTER(WHERE days_ago<=365) AS n365,\n min(days_ago) AS recency,avg(price) AS mean_price,\n avg(CASE WHEN sales_channel_id=2 THEN 1.0 ELSE 0.0 END) AS channel2\n FROM history GROUP BY article_id),\npair AS (SELECT customer_id,article_id,count(*) AS n FROM history GROUP BY customer_id,article_id),\nt AS (SELECT customer_id,product_type_no,count(*) AS n FROM history GROUP BY customer_id,product_type_no),\ns AS (SELECT customer_id,section_no,count(*) AS n FROM history GROUP BY customer_id,section_no),\np AS (SELECT customer_id,product_code,count(*) AS n FROM history GROUP BY customer_id,product_code),\nd AS (SELECT customer_id,department_no,count(*) AS n FROM history GROUP BY customer_id,department_no),\nc AS (SELECT customer_id,colour_group_code,count(*) AS n FROM history GROUP BY customer_id,colour_group_code),\nprod AS (SELECT product_code,count(*) AS n FROM history WHERE days_ago<=30 GROUP BY product_code)\n\nSELECT coalesce(i.n7,0) AS f_item_count_7d,coalesce(i.n30,0) AS f_item_count_30d,\ncoalesce(i.n90,0) AS f_item_count_90d,coalesce(i.n,0) AS f_item_count_all,\ncoalesce(u.n30,0) AS f_user_count_30d,coalesce(u.n,0) AS f_user_count_all,\nu.recency AS f_user_recency,i.recency AS f_item_recency,coalesce(pair.n,0) AS f_pair_count,\ncoalesce(s.n/nullif(u.n,0),0) AS f_user_section_rate,\ncoalesce(t.n/nullif(u.n,0),0) AS f_user_type_rate\n\nFROM reference_pairs x LEFT JOIN u USING(customer_id) LEFT JOIN i USING(article_id)\nLEFT JOIN pair ON pair.customer_id=x.customer_id AND pair.article_id=x.article_id\nLEFT JOIN t ON t.customer_id=x.customer_id AND t.product_type_no=x.raw_i_product_type_no\nLEFT JOIN s ON s.customer_id=x.customer_id AND s.section_no=x.raw_i_section_no\nLEFT JOIN p ON p.customer_id=x.customer_id AND p.product_code=x.raw_i_product_code\nLEFT JOIN d ON d.customer_id=x.customer_id AND d.department_no=x.raw_i_department_no\nLEFT JOIN c ON c.customer_id=x.customer_id AND c.colour_group_code=x.raw_i_colour_group_code\nLEFT JOIN prod ON prod.product_code=x.raw_i_product_code ORDER BY x.rid\n"

{
  "aggregates": [
    {
      "name": "f_pair",
      "keys": [
        "customer_id",
        "article_id"
      ],
      "sql": "count(*)"
    },
    {
      "name": "f_type",
      "keys": [
        "customer_id",
        "product_type_no"
      ],
      "sql": "count(*) FILTER (WHERE days_ago <= 30)"
    }
  ],
  "derived": [
    {
      "name": "f_type_ratio",
      "sql": "f_pair / nullif(f_type, 0)"
    }
  ]
}